<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Café com Afeto</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <main class="acoes">

        <!-- CARD DOAÇÃO -->
        <section class="card card-doacao">

            <div class="icone">
                🎁
            </div>

            <div class="conteudo">

                <h2>Quero fazer uma doação</h2>

                <p>
                    Informe o que deseja doar e combine a
                    coleta ou escolha um ponto de entrega.
                </p>

                <button
                    class="botao botao-doacao"
                    id="btnDoacao">
                    Cadastrar doação
                </button>

            </div>

        </section>


        <!-- CARD VOLUNTÁRIO -->
        <section class="card card-voluntario">

            <div class="icone">
                🙌
            </div>

            <div class="conteudo">

                <h2>Quero ser voluntário</h2>

                <p>
                    Veja ações abertas, escolha uma atividade e
                    confirme sua participação.
                </p>

                <button
                    class="botao botao-voluntario"
                    id="btnVoluntario">
                    Ver ações
                </button>

            </div>

        </section>

    </main>


    <script src="script.js"></script>

</body>
</html>
